    {
      "Id": "e07cf72f-2db0-47bd-95df-f6aca45d4e54"/*Store Position in vertexColor*/,
      "SymbolId": "b722014e-402f-4089-a876-16aefab3c012",
      "SymbolName": "Lib.mesh.modify.CustomVertexShader",
      "Name": "Store Position in vertexColor",
      "InputValues": [
        {
          "Id": "074aed08-271d-4f2b-869f-1e2e869fdba5"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "//float4 noise = hash41u(vertexIndex);\n//float3 pos = v.Position;\n//float4 f = GetField( float4(pos, 0));\n//float4 fColor = GetField( float4(pos, 1));\n// we store the position in vertex color\nv.ColorRGB = v.Position;\n//v.Position +=  A * (noise - 0.5) * f.w;"
        }
      ],
