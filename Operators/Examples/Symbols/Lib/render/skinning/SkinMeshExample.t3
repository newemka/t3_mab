    {
      "Id": "f77923ff-4c81-4179-a521-613b0184483b"/*CustomDrawMesh*/,
      "SymbolId": "c78d114e-b404-491f-93a8-024a382586bd",
      "SymbolName": "Lib.mesh.draw.CustomDrawMesh",
      "InputValues": [
        {
          "Id": "05feb9d0-3bfc-4c96-b79e-b884132813e9"/*B*/,
          "Type": "System.Single",
          "Value": 0.14
        },
        {
          "Id": "7a6ca5a8-17a6-4a8b-9610-ed4c9e292cfe"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "float4 d = GetField( float4(pin.colorRGB, 1));\n\nfloat it = pin.colorRGB.y;\npin.colorRGB= 1;\nSetupFrag(pin);\n\n//if(it<A||it>B)\n//{frag.Metalness = 1;frag.Roughness = 0;}\nfrag.Roughness -= d.b;\n\n\n//frag.Metalness += Points[pin.pointIndex].FX1;\nfrag.Metalness += d.b;\n\nc = ComputePbr();\nc*= d;\n"
        },
        {
          "Id": "7f731ea3-c246-4e9c-95b3-b30260887161"/*EnableZTest*/,
          "Type": "System.Boolean",
          "Value": true
        },
